  "license": "MIT",
  "author": "",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "proxy",
    "clash",
